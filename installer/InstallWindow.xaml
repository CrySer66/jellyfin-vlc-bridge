<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MaintenanceInstallTitle}" Width="1000" Height="740" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI" FontSize="14"
        Foreground="#17283E" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Grid Background="{StaticResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Sidebar}">
      <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Image Source="{StaticResource ApplicationIcon}" Width="43" Height="43" HorizontalAlignment="Left" Margin="0,0,0,18"/>
          <TextBlock Text="Jellyfin" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="VLC Bridge" Foreground="#A7BACF" Margin="0,3,0,32"/>
          <TextBlock Text="{DynamicResource MaintenanceInstallTitle}" Foreground="#91A7C0" FontSize="12" Margin="0,0,0,18"/>
          <Border x:Name="Step0" Background="#263D56" BorderBrush="#395773" BorderThickness="1" CornerRadius="11" Padding="14" Margin="-10,0,-10,12">
            <StackPanel Orientation="Horizontal"><TextBlock Text="01" Foreground="#84E2D0" Margin="0,0,14,0"/><TextBlock Text="{DynamicResource StepConnect}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
          </Border>
          <Border x:Name="Step1" CornerRadius="11" Padding="14" Margin="-10,0,-10,12">
            <StackPanel Orientation="Horizontal"><TextBlock Text="02" Foreground="#91A7C0" Margin="0,0,14,0"/><TextBlock Text="{DynamicResource StepAuthorize}" Foreground="#B9C9DA"/></StackPanel>
          </Border>
          <Border x:Name="Step2" CornerRadius="11" Padding="14" Margin="-10,0,-10,12">
            <StackPanel Orientation="Horizontal"><TextBlock Text="03" Foreground="#91A7C0" Margin="0,0,14,0"/><TextBlock Text="{DynamicResource StepReady}" Foreground="#B9C9DA"/></StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border BorderBrush="#304357" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>
          <TextBlock x:Name="VersionLabel" Foreground="#91A7C0" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,28,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,24">
        <TextBlock x:Name="Headline" Text="{DynamicResource MaintenanceInstallLead}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="{DynamicResource MaintenanceInstallDetail}" Style="{StaticResource Caption}"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock x:Name="CardTitle" Text="{DynamicResource ServerAddress}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
              <TextBlock x:Name="AddressHint" Text="{DynamicResource ServerAddressHint}" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
              <TextBox x:Name="ServerBox" MinHeight="44" Padding="12,0" AutomationProperties.Name="{DynamicResource ServerAddress}"/>
              <Button x:Name="ChangeServerButton" Content="{DynamicResource ChangeServer}" HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed"/>
              <Border x:Name="CodeCard" Visibility="Collapsed" Background="#E8F5F1" CornerRadius="12" Padding="20" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource QuickConnectCode}" Foreground="#087C73" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                  <TextBlock x:Name="CodeValue" Text="------" Foreground="#087C73" FontSize="40" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,6"/>
                  <TextBlock Text="{DynamicResource QuickConnectInstructions}" Foreground="#3E6C63" TextAlignment="Center" FontSize="13"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="Instructions" Text="{DynamicResource PerUserInstall}" Style="{StaticResource Caption}" Margin="0,20,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="20" Background="#E8F5F1" BorderBrush="#CEE8DF">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" Background="#D0EBE2" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,14,0">
                <Viewbox Margin="9"><Path Stroke="#087C73" StrokeThickness="2" Data="M 3,10 L 3,20 L 17,20 L 17,10 Z M 6,10 L 6,6 A 4,4 0 0 1 14,6 L 14,10"/></Viewbox>
              </Border>
              <TextBlock Grid.Column="1" Text="{DynamicResource InstallerPrivacyNote}" Foreground="#3E6C63" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,22,4,0">
        <TextBlock x:Name="StatusLabel" Text="{DynamicResource ReadyToInstall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" BorderThickness="0" Background="#DFE9ED" Foreground="#087C73" Margin="0,0,0,18"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="ExtensionButton" Content="{DynamicResource OpenChromeStore}" Visibility="Collapsed" Margin="0,0,10,10"/>
          <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Margin="0,0,10,10" MinWidth="100"/>
          <Button x:Name="InstallButton" Content="{DynamicResource Install}" Style="{StaticResource PrimaryButton}" MinWidth="165" Margin="0,0,0,10" IsDefault="True"/>
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
