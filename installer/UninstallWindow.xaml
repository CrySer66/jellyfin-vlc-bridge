<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="UninstallWindow" Title="{DynamicResource UninstallTitle}"
        Width="900" Height="650" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB"
        FontFamily="Segoe UI" FontSize="14" Foreground="#17283E"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Sidebar}" Padding="18,28,18,20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,36">
          <Image Source="{StaticResource ApplicationIcon}" Width="43" Height="43" HorizontalAlignment="Left" Margin="0,0,0,15" />
          <TextBlock Text="Jellyfin" Foreground="White" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="VLC Bridge" Foreground="#A7BACF" FontSize="14" Margin="0,1,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="#263D56" BorderBrush="#395773" BorderThickness="1" CornerRadius="11" Padding="14,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Path Data="M 3 5 H 15 M 7 2 H 11 L 12 5 H 6 Z M 5 5 L 6 17 H 12 L 13 5 M 8 8 V 14 M 10 8 V 14" Stroke="#DCE9F4" StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource UninstallNavigation}" Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="10,24,10,0">
          <Border Background="#2C3D54" Height="1" Margin="0,0,0,19" />
          <TextBlock Text="{DynamicResource UninstallLocalOnly}" Foreground="#A7BACF" FontSize="12" LineHeight="19" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,28,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,24">
        <TextBlock x:Name="PageTitle" Text="{DynamicResource UninstallPageTitle}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,7" />
        <TextBlock x:Name="PageSubtitle" Text="{DynamicResource UninstallQuestion}" Style="{StaticResource Caption}" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <Grid>
          <StackPanel x:Name="ChoicePanel">
            <RadioButton x:Name="KeepOption" GroupName="RemovalMode" IsChecked="True" Style="{StaticResource RadioOption}" HorizontalContentAlignment="Stretch" Margin="0,2,0,14" AutomationProperties.Name="{DynamicResource UninstallKeep}">
              <StackPanel>
                <TextBlock Text="{DynamicResource UninstallKeep}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource UninstallKeepDescription}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PurgeOption" GroupName="RemovalMode" Style="{StaticResource RadioOption}" HorizontalContentAlignment="Stretch" Margin="0,0,0,18" AutomationProperties.Name="{DynamicResource UninstallRemoveAll}">
              <StackPanel>
                <TextBlock Text="{DynamicResource UninstallRemoveAll}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource UninstallRemoveAllDescription}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
              </StackPanel>
            </RadioButton>
            <Border Background="#EDF3F8" CornerRadius="12" Padding="16">
              <TextBlock Text="{DynamicResource UninstallMediaPreserved}" Style="{StaticResource Caption}" />
            </Border>
          </StackPanel>
          <Border x:Name="ProgressPanel" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="{DynamicResource UninstallWorking}" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="ProgressLabel" Text="{DynamicResource UninstallWorkingDetail}" Style="{StaticResource Caption}" Margin="0,10,0,22" />
              <Border Background="#E4ECEF" Height="8" CornerRadius="4" ClipToBounds="True">
                <Grid><Border x:Name="ProgressFill" Background="#087C73" CornerRadius="4" Width="72" HorizontalAlignment="Left" /></Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border x:Name="ResultPanel" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top">
            <StackPanel>
              <Border x:Name="ResultIconBackground" Background="#E2F3EC" Width="56" Height="56" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,20">
                <Path x:Name="ResultIcon" Data="M 2 10 L 8 16 L 20 3" Stroke="#087C73" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="24" Height="24" />
              </Border>
              <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="ResultMessage" Style="{StaticResource Caption}" Margin="0,10,0,0" />
              <Border x:Name="SettingsResultCard" Background="#F3F7FA" CornerRadius="11" Padding="14" Margin="0,20,0,0">
                <TextBlock x:Name="SettingsResult" Text="{DynamicResource SettingsKept}" Style="{StaticResource Caption}" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,24,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" HorizontalAlignment="Left" MinWidth="104" IsCancel="True" />
        <Button x:Name="RemoveButton" Grid.Column="1" Content="{DynamicResource UninstallAction}" Style="{StaticResource DangerButton}" MinWidth="158" Margin="16,0,0,0" />
        <Button x:Name="CloseButton" Grid.Column="1" Content="{DynamicResource Close}" Style="{StaticResource PrimaryButton}" MinWidth="124" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Grid>
</Window>
